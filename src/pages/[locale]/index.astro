---
// All locale metadata (codes, native names, page titles, descriptions,
// script direction) lives in a single file. Adding a new locale = adding
// one entry to src/locales.ts and a corresponding strings JSON.
import { SUPPORTED_LOCALES, LOCALES, type Locale } from '~/locales.js';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const meta = LOCALES[locale];
const dir = meta.dir;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Pre-paint theme + skin application — avoids a light/dark/skin flash.
        Must run before any CSS link is inserted. */}
    <script is:inline>
      (function () {
        try {
          var rawT = localStorage.getItem('tuneout.theme');
          if (rawT) {
            var t = JSON.parse(rawT);
            if (t === 'light' || t === 'dark') {
              document.documentElement.setAttribute('data-theme', t);
            }
          }
          var rawS = localStorage.getItem('tuneout.skin');
          if (rawS) {
            var s = JSON.parse(rawS);
            if (typeof s === 'string' && /^[a-z0-9][a-z0-9_-]*$/.test(s) && s !== 'classic') {
              document.documentElement.setAttribute('data-theme-skin', s);
              var link = document.createElement('link');
              link.rel = 'stylesheet';
              link.id = 'theme-skin';
              link.href = '/themes/' + s + '/theme.css';
              document.head.appendChild(link);
            }
          }
        } catch (e) {}
      })();
    </script>
    {/* Two color-scheme aware theme-color meta tags; replaced by JS at runtime for explicit overrides. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbfd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0d14" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Tune Out" />
    <meta name="application-name" content="Tune Out" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div id="app">
      <div class="boot">
        <div class="boot-logo" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="44" height="44">
            <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#0ea5e9"/>
              <stop offset="0.55" stop-color="#2563eb"/>
              <stop offset="1" stop-color="#1e3a8a"/>
            </linearGradient></defs>
            <rect width="32" height="32" rx="7" fill="url(#lg)"/>
            <g fill="none" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round"><path d="M 14.5 6.5 A 9.5 9.5 0 1 0 17.5 6.5"/></g>
            <circle cx="16" cy="16" r="2.4" fill="#ffffff"/>
          </svg>
        </div>
        <p class="boot-text">Tune Out</p>
      </div>
    </div>
    <script>
      import '~/spa/main.ts';
    </script>
  </body>
</html>
